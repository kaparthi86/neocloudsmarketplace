# Neo Clouds Marketplace — copy to .env for local dev (optional; host injects env in production)

NODE_ENV=development
PORT=8788

# Honesty banner is always shown. Optional override for the wording:
# BETA_MESSAGE=A listing is available only while the provider agent is online. No payments collected.
BETA_TESTING=0

# SQLite persistence (survives restarts). On Render this is the disk mount.
# Use :memory: only for tests.
NEO_DB_PATH=data/neo-clouds.sqlite

# Operator inbox at /admin. Required in production to read contact notes.
# ADMIN_API_KEY=

# Email. Set Resend OR a webhook. Without either, notes stay in /admin only.
# RESEND_API_KEY=
# NEO_MAIL_FROM=Neo Clouds <hello@neocloudsmarketplace.com>
# NEO_OPERATOR_EMAIL=hellonecoloudsmarketplace@googlegroups.com
# NEO_MAIL_WEBHOOK_URL=

# Pending live reserves cancel if the agent does not ack in this window (ms).
# RESERVATION_PROVISION_TIMEOUT_MS=900000

# Live agent online window (ms)
# AGENT_HEARTBEAT_TTL_MS=90000

# Shown in /api/health and legal pages
CANONICAL_DOMAIN=neocloudsmarketplace.com
